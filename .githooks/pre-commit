#!/bin/sh
# All three commands are byte-identical to ci.yml's Format, Clippy and Doc steps.

set -e

echo "pre-commit: cargo fmt --check"
# `cargo +toolchain` auto-installs a toolchain it does not have, so the check comes first
# and through `rustup run`, which does not: it exits 1 with the name of what is missing.
# Without it a fresh clone's first commit stalls for a silent 200MB fetch — the output
# below is captured, so the download would not even print. `rustfmt`, not `rustc`, so a
# toolchain present without the component is caught too; same shape as public-api.sh:29.
nightly=nightly-2026-09-11
rustup run "$nightly" rustfmt --version >/dev/null 2>&1 || { echo "::error::$nightly with rustfmt missing: rustup toolchain install $nightly --component rustfmt"; exit 1; }
# Three of `rustfmt.toml`'s four options are nightly-only, and rustfmt skips an option it
# cannot set with a `Warning:` and exit 0 — so a stable fmt, or a typo'd option name,
# passes this gate having enforced nothing. The output is captured to be searched.
fmt=$(cargo "+$nightly" fmt --all -- --check 2>&1) || { printf '%s\n' "$fmt"; exit 1; }
case "$fmt" in *Warning:*) printf '%s\n' "$fmt"; exit 1 ;; esac

echo "pre-commit: cargo clippy -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

# Not the test suite, which is minutes; this is seconds on a warm target dir, and
# it is the only one of the three that reads a doc comment at all.
echo "pre-commit: cargo doc -D warnings"
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --document-private-items --all-features

echo "pre-commit: ok"
